Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"computation", " ", "of", " ", "E1"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"derE0", "[", 
      RowBox[{"phi1_", ",", " ", "phi2_", ",", " ", "s_"}], "]"}], ":=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"E0", "[", 
           RowBox[{"phi1", ",", " ", "phi2", ",", " ", "s"}], "]"}], ",", " ",
           "phi1"}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"E0", "[", 
           RowBox[{"phi1", ",", " ", "phi2", ",", " ", "s"}], "]"}], ",", " ",
           "phi2"}], "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "when", " ", "f1", " ", "is", " ", "in", " ", "normal", " ", "form"}], ",",
      " ", 
     RowBox[{
     "computing", " ", "the", " ", "following", " ", "integral", " ", 
      "effectively", " ", "only", " ", "multiplies", " ", "f1", " ", "with", " ",
       "a", " ", "prefactor", " ", "of", " ", "s"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"intgl1", "[", 
      RowBox[{"phi1_", ",", " ", "phi2_", ",", " ", "s_"}], "]"}], ":=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"f1", "[", 
        RowBox[{
         RowBox[{"phi1", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"s", "-", "zeta"}], ")"}], "*", 
           RowBox[{"omega0", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}]}], ",", " ", 
         RowBox[{"phi2", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"s", "-", "zeta"}], ")"}], "*", 
           RowBox[{"omega0", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"zeta", ",", " ", "0", ",", " ", "s"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "the", " ", "next", " ", "line", " ", "is", " ", "a", " ", "weird", " ", 
     "workaround", " ", "to", " ", "evaluate", " ", 
     RowBox[{"e1", "[", 
      RowBox[{
       RowBox[{"phi1", "+", 
        RowBox[{"s", "*", 
         RowBox[{"omega0", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ",", " ", 
       RowBox[{"phi2", "+", 
        RowBox[{"s", "*", 
         RowBox[{"omega0", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}]}], "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
       "doing", " ", "this", " ", "\"\<normally\>\"", " ", "throws", " ", 
        "an", " ", "error"}], ",", " ", 
       RowBox[{
       "because", " ", "something", " ", "goes", " ", "wrong", " ", "in", " ",
         "computing", " ", "the", " ", "derivative", " ", "in", " ", "the", " ",
         "definition", " ", "of", " ", "e1"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"e1tilde", "[", 
