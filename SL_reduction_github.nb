           RowBox[{"omega0", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}]}]}], ",", " ", 
        RowBox[{"y", " ", "->", " ", 
         RowBox[{"phi2", "+", 
          RowBox[{"s", "*", 
           RowBox[{"omega0", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
